# OAuth 2.0 client credentials from Google Cloud Console
# Create a "Web application" client with redirect URI:
#   http://localhost:8787/auth/callback
# (or whatever you set in OAUTH_REDIRECT_URI below, if hosting publicly)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Port the server listens on (default 8787)
PORT=8787

# Optional: override the OAuth callback URL when hosting behind a reverse proxy.
# Must match an Authorized redirect URI in your Google OAuth client.
# OAUTH_REDIRECT_URI=https://gtasks.example.com/auth/callback

# Server API key — leave blank; it's auto-generated and appended on first run.
API_KEY=
